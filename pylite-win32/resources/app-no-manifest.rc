// Diagnostic resource file for the Windows startup A/B/C test only.
// It intentionally omits RT_MANIFEST while retaining the icon and version data.
#define VS_VERSION_INFO 1
#define VOS_NT_WINDOWS32 0x00040004L
#define VFT_APP 0x00000001L
1 ICON "pylite.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "CompanyName", "PyLite"
      VALUE "FileDescription", "Lightweight Python Editor"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "PyLite"
      VALUE "OriginalFilename", "PyLite.exe"
      VALUE "ProductName", "PyLite"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
